/*
 * TOFU60 BLE 3.0 — ANSI 7u HHKB-style macOS layout
 * Based on openkbd/zmk-config-tofu60-ble-3.0 keyboard source.
 * Intended to REPLACE: config/boards/shields/klink_kbd/tofu60_ble_v3_ansi.keymap
 * Selected target: board klink + shield tofu60_ble_v3_ansi_7u.
 * No changes to matrix, hardware or bootloader definitions.
 *
 * ALL_KEYS index positions are fixed (15 / 14 / 13 / 14 / 8).
 * In the HHKB 7u assembly, some positions are physically unpopulated.
 * Fn+B: hold ~3 sec for bootloader; Fn+U: switch to USB output.
 * Need to restore ZMK Studio stock settings after firmware update.
 */
#include "common.keymap"
#define UF_RESET bootloader_reset 0 0
/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &kp BSLH  &none
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSPC
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp RET
                &kp LSHFT  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT  &mo 1
                &none  &kp LALT  &kp LGUI  &kp SPACE  &kp RGUI  &kp RALT  &none  &none
            >;
        };
        layer1 {
            bindings = <
                &kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp INSERT  &trans
                &kp CLCK  &trans  &trans  &trans  &trans  &trans  &trans  &Device_USB  &trans  &trans  &trans  &kp UP  &trans  &kp DELETE
                &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans  &trans  &trans  &trans  &kp HOME  &kp PAGE_UP  &kp LEFT  &kp RIGHT  &trans
                &trans  &none  &trans  &trans  &trans  &trans  &UF_RESET  &trans  &trans  &kp END  &kp PAGE_DOWN  &kp DOWN  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer2 { status = "reserved"; };
        layer3 { status = "reserved"; };
        layer4 { status = "reserved"; };
        layer5 { status = "reserved"; };
        layer6 { status = "reserved"; };
        layer7 { status = "reserved"; };
    };
};
